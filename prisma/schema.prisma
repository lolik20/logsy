// Prisma schema для Logsy — сервиса мониторинга uptime.
// БД — PostgreSQL. DATABASE_URL задаётся в .env
// (напр. postgresql://user:pass@host:5432/logsy?schema=public).
// Для локальной разработки на SQLite смените provider на "sqlite" и
// используйте URL вида file:./dev.db.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------- Пользователи и авторизация (совместимо с Auth.js Prisma adapter) -------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          String    @default("USER") // USER | ADMIN
  signupIp      String?   // IP, с которого зарегистрировался пользователь (антифрод)
  createdAt     DateTime  @default(now())

  accounts      Account[]
  sessions      Session[]
  projects      Project[]
  contacts      Contact[]
  subscription  Subscription?
  payments      Payment[]

  @@index([signupIp])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ------------------------------- Домен приложения -------------------------------

model Project {
  id        String    @id @default(cuid())
  userId    String
  name      String
  // Домен проекта. Уникален глобально: по нему сервис логирования однозначно
  // определяет проект по заголовку Origin входящего запроса (keyless-модель).
  domain    String    @unique
  createdAt DateTime  @default(now())

  // Контроль срока действия SSL-сертификата домена проекта.
  checkSsl     Boolean   @default(true)
  sslStatus    String    @default("PENDING") // VALID | EXPIRING | EXPIRED | ERROR | OFF | PENDING
  sslExpiresAt DateTime? // дата окончания действия сертификата (notAfter)
  sslDaysLeft  Int?      // сколько полных дней осталось до окончания
  sslIssuer    String?   // издатель сертификата (CA)
  sslCheckedAt DateTime? // когда сертификат проверяли в последний раз
  // Порог (в часах) последнего отправленного предупреждения: 168 | 72 | 24 | 1 | 0.
  // Нужен, чтобы каждое оповещение (за неделю/3 дня/1 день/1 час/истёк) ушло один раз.
  sslAlertHours Int?

  // ---- Тарификация на уровне проекта (перевод биллинга с per-user на per-project) ----
  // Тариф проекта: T300 (базовый) | T1000 | T3000. null — тариф ещё не выбран (идёт триал).
  tier          String?
  // TRIAL — идёт пробный период; ACTIVE — оплачен; INACTIVE — истёк/не оплачен.
  billingStatus String    @default("TRIAL")
  // Конец оплаченного периода (для ACTIVE).
  currentPeriodEnd DateTime?
  // Конец пробного периода (для TRIAL).
  trialEndsAt   DateTime?
  // Значение currentPeriodEnd, для которого уже отправлено предупреждение об истечении
  // (чтобы напоминание ушло один раз за период). Аналог поля в Subscription.
  expiryAlertSentFor DateTime?

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  monitors    Monitor[]
  logSessions LogSession[]
  logUsage    LogUsage[]
  payments    Payment[]

  @@index([userId])
}

model Monitor {
  id             String        @id @default(cuid())
  projectId      String
  name           String
  url            String
  port           Int?          // порт для проверки; если не задан — 80 (http) или 443 (https)
  method         String        @default("GET") // GET | POST | PUT | DELETE
  interval       String        @default("1m")  // 1m | 1h | 1d
  expectedStatus Int           @default(200)
  timeoutMs      Int           @default(10000)
  headers        String?       // JSON-объект заголовков { "Name": "Value" }
  bodyType       String        @default("NONE") // NONE | JSON | XML | FORM
  body           String?       // тело запроса (для POST/PUT/DELETE)
  isActive       Boolean       @default(true)
  lastStatus     String        @default("PENDING") // UP | DOWN | PENDING
  lastCheckedAt  DateTime?
  createdAt      DateTime      @default(now())

  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  results        CheckResult[]
  alerts         Alert[]

  @@index([projectId])
  @@index([isActive])
}

model CheckResult {
  id             String   @id @default(cuid())
  monitorId      String
  ok             Boolean
  statusCode     Int?
  responseTimeMs Int?
  error          String?
  createdAt      DateTime @default(now())

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId, createdAt])
}

// ------------------------------- Сервис логирования -------------------------------
// Клиентский SDK на сайте проекта ловит фронт-ошибки и сетевые запросы, группирует их
// в пользовательские сессии и батчами шлёт на /api/logger/ingest. Проект определяется
// по Origin запроса (домен проекта). Данные хранятся ограниченный срок (ретеншн по тарифу).

model LogSession {
  id         String   @id @default(cuid())
  projectId  String
  // Идентификатор сессии, сгенерированный на клиенте (sessionStorage).
  sessionKey String
  userAgent  String?
  ip         String?
  startedAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  project Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  events  LogEvent[]

  @@unique([projectId, sessionKey])
  @@index([projectId, startedAt])
}

model LogEvent {
  id         String   @id @default(cuid())
  // projectId денормализован, чтобы очистка по ретеншну и учёт квоты шли одним deleteMany/count.
  projectId  String
  sessionId  String
  // ERROR | UNHANDLED_REJECTION | SLOW_REQUEST | HTTP_ERROR
  type       String
  message    String?
  stack      String?
  url        String?  // URL страницы, где произошло событие
  route      String?  // URL/маршрут сетевого запроса (с query-строкой)
  query      String?  // query-параметры запроса (усечено)
  method     String?
  statusCode Int?
  durationMs Int?
  reqBody    String?  // тело запроса / payload (усечено)
  meta       String?  // произвольный JSON (расширяемость; hook под запись экрана)
  createdAt  DateTime @default(now())

  session LogSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([sessionId, createdAt])
}

// Суточный счётчик объёма принятых логов на проект — для контроля квоты тарифа.
model LogUsage {
  id        String   @id @default(cuid())
  projectId String
  day       DateTime @db.Date
  bytes     BigInt   @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, day])
  @@index([projectId, day])
}

model Contact {
  id        String   @id @default(cuid())
  userId    String
  type      String   @default("EMAIL")
  value     String
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  alerts Alert[]

  @@index([userId])
}

model Alert {
  id        String   @id @default(cuid())
  monitorId String
  contactId String
  message   String
  kind      String   @default("DOWN") // DOWN | RECOVERY | SSL | SUBSCRIPTION
  sentAt    DateTime @default(now())

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([monitorId])
}

model Subscription {
  id               String    @id @default(cuid())
  userId           String    @unique
  plan             String    @default("FREE") // FREE | TRIAL | PAID
  sitesLimit       Int       @default(1)
  priceRub         Int       @default(300)
  status           String    @default("inactive") // active | inactive
  // Для TRIAL — дата окончания пробного периода; для PAID — конец оплаченного периода.
  currentPeriodEnd DateTime?
  // Значение currentPeriodEnd, для которого уже отправлено предупреждение
  // «подписка истекает завтра». Нужно, чтобы оповещение ушло один раз за период:
  // при продлении currentPeriodEnd меняется — и напоминание срабатывает заново.
  expiryAlertSentFor DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Платежи через Т-Кассу (T-Bank эквайринг). Создаётся при инициации оплаты
// методом Init; статус обновляется по нотификации от Т-Кассы.
model Payment {
  id         String   @id @default(cuid())
  userId     String
  // Проект, тариф которого оплачивается (per-project биллинг).
  projectId  String?
  // Тариф, активируемый после оплаты: T300 | T1000 | T3000.
  tier       String?
  // OrderId, переданный в Т-Кассу (совпадает с id этой записи).
  orderId    String   @unique
  // PaymentId, присвоенный Т-Кассой.
  paymentId  String?
  // Кол-во сайтов (вырожденное поле, оставлено для совместимости со старыми оплатами).
  sites      Int      @default(1)
  // Длительность оплаченного периода в месяцах (1 | 3 | 12).
  months     Int      @default(1)
  // Сумма в рублях.
  amountRub  Int
  // NEW | AUTHORIZED | CONFIRMED | REJECTED | REFUNDED | CANCELED
  status     String   @default("NEW")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([projectId])
}
