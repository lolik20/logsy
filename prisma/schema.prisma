// Prisma schema для Logsy — сервиса мониторинга uptime.
// БД — PostgreSQL. DATABASE_URL задаётся в .env
// (напр. postgresql://user:pass@host:5432/logsy?schema=public).
// Для локальной разработки на SQLite смените provider на "sqlite" и
// используйте URL вида file:./dev.db.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------- Пользователи и авторизация (совместимо с Auth.js Prisma adapter) -------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          String    @default("USER") // USER | ADMIN
  signupIp      String?   // IP, с которого зарегистрировался пользователь (антифрод)
  createdAt     DateTime  @default(now())

  accounts      Account[]
  sessions      Session[]
  projects      Project[]
  contacts      Contact[]
  subscription  Subscription?
  payments      Payment[]

  @@index([signupIp])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ------------------------------- Домен приложения -------------------------------

model Project {
  id        String    @id @default(cuid())
  userId    String
  name      String
  // Домен проекта. Уникален глобально: по нему сервис логирования однозначно
  // определяет проект по заголовку Origin входящего запроса (keyless-модель).
  domain    String    @unique
  createdAt DateTime  @default(now())

  // Контроль срока действия SSL-сертификата домена проекта.
  checkSsl     Boolean   @default(true)
  sslStatus    String    @default("PENDING") // VALID | EXPIRING | EXPIRED | ERROR | OFF | PENDING
  sslExpiresAt DateTime? // дата окончания действия сертификата (notAfter)
  sslDaysLeft  Int?      // сколько полных дней осталось до окончания
  sslIssuer    String?   // издатель сертификата (CA)
  sslCheckedAt DateTime? // когда сертификат проверяли в последний раз
  // Порог (в часах) последнего отправленного предупреждения: 168 | 72 | 24 | 1 | 0.
  // Нужен, чтобы каждое оповещение (за неделю/3 дня/1 день/1 час/истёк) ушло один раз.
  sslAlertHours Int?

  // Контроль срока регистрации домена проекта (данные регистратора по RDAP/WHOIS).
  checkDomain     Boolean   @default(true)
  domainStatus    String    @default("PENDING") // VALID | EXPIRING | EXPIRED | ERROR | OFF | PENDING
  domainExpiresAt DateTime? // дата окончания срока регистрации домена
  domainDaysLeft  Int?      // сколько полных дней осталось до окончания регистрации
  domainRegistrar String?   // регистратор домена (по данным RDAP)
  domainCheckedAt DateTime? // когда срок регистрации проверяли в последний раз
  // Порог (в днях) последнего отправленного предупреждения: 30 | 14 | 7 | 3 | 1 | 0.
  // Нужен, чтобы каждое оповещение (за 30/14/7/3/1 день/истёк) ушло один раз.
  domainAlertDays Int?

  // Обратная форма ошибок в сервисе логирования: если включена, клиентский SDK на
  // сайте проекта показывает плавающую кнопку (правый нижний угол на ПК и мобилке),
  // через которую посетитель может кратко сообщить об ошибке. Сообщение приходит как
  // событие USER_REPORT в его сессию логирования.
  feedbackEnabled Boolean @default(false)

  // Запись экрана пользовательских сессий (rrweb). Если включена, клиентский SDK
  // подгружает self-hosted рекордер (см. /public/logsy-rec.js) и шлёт DOM-снимки и
  // инкременты на /api/logger/rec — их можно воспроизвести на странице сессии как видео.
  // По умолчанию выключена: запись объёмна и включается осознанно. Приватность обеспечивает
  // рекордер (пароли и поля с data-logsy-mask маскируются на клиенте до отправки).
  recordSession Boolean @default(false)

  // Порог «медленного» запроса/ресурса в миллисекундах, настраиваемый из панели. SDK
  // читает его через /api/logger/config и считает медленными запросы/статические файлы
  // дольше этого значения. Атрибут data-slow-ms на теге скрипта, если задан, переопределяет
  // это значение на конкретной странице.
  slowMs Int @default(1000)

  // ---- Кастомная тарификация на уровне проекта ----
  // Параметры настраиваются ползунками на вкладке «Тариф»: базовый бесплатный объём
  // (300 сессий/сутки, хранение 12 часов) плюс помесячная доплата за расширение
  // (1 ₽/мес за суточную сессию сверх 300, 10 ₽/мес за час хранения сверх 12).
  // Суточная квота пользовательских сессий.
  sessionsPerDay Int      @default(300)
  // Срок хранения логов, часов.
  retentionHours Int      @default(12)
  // Легаси-поле старой тарификации (T1000 | T3000). Больше не используется.
  tier          String?
  // FREE — бесплатный тариф (по умолчанию); ACTIVE — оплачен; INACTIVE — истёк/не оплачен.
  billingStatus String    @default("FREE")
  // Конец оплаченного периода (для ACTIVE).
  currentPeriodEnd DateTime?
  // Устаревшее поле от отменённого пробного периода; больше не заполняется.
  trialEndsAt   DateTime?
  // Значение currentPeriodEnd, для которого уже отправлено предупреждение об истечении
  // (чтобы напоминание ушло один раз за период). Аналог поля в Subscription.
  expiryAlertSentFor DateTime?

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  monitors      Monitor[]
  logSessions   LogSession[]
  logUsage      LogUsage[]
  logExceptions LogException[]
  pages         ProjectPage[]
  payments      Payment[]
  tasks         Task[]

  @@index([userId])
}

// Задачи проекта — простая доска со статусами (канбан). Задачу можно создать вручную
// или она заводится автоматически при получении сообщения об ошибке из обратной формы
// (событие USER_REPORT). Статусы: CREATED (создано) → IN_PROGRESS (в работе) →
// DONE (выполнено). Пользователь редактирует задачи и перетаскивает их между колонками.
model Task {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  description String?
  // CREATED | IN_PROGRESS | DONE. Новая задача и задача из репорта — в статусе CREATED.
  status      String   @default("CREATED")
  // Порядок задачи внутри своей колонки (меньше — выше). Обновляется при перетаскивании.
  position    Int      @default(0)
  // Источник задачи: MANUAL (создана вручную) | REPORT (из обратной формы ошибок).
  source      String   @default("MANUAL")
  // Почта отправителя обратной формы (если задача заведена из репорта и почта указана).
  reporterEmail String?
  // Сессия логирования, породившая задачу (для ссылки на неё), если источник — REPORT.
  sessionId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project  Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages TaskMessage[]

  @@index([projectId, status])
}

// Переписка с пользователем в рамках задачи. Задачи из обратной формы ошибок
// (source REPORT) привязаны к почте отправителя (reporterEmail): владелец проекта
// может отвечать на обращение письмом прямо из карточки задачи (сообщение
// OUTGOING уходит на reporterEmail через SMTP), а последующие сообщения того же
// пользователя (из той же сессии, с той же почтой) дописываются сюда же как
// INCOMING, а не плодят новые задачи. Первое сообщение обращения хранится в
// Task.description — эта таблица хранит дальнейшую переписку в хронологическом порядке.
model TaskMessage {
  id        String   @id @default(cuid())
  taskId    String
  // OUTGOING — ответ владельца пользователю (отправлен письмом);
  // INCOMING — сообщение пользователя (из обратной формы ошибок).
  direction String
  body      String
  // Адреса письма для истории: INCOMING — почта пользователя-отправителя;
  // OUTGOING — адрес, на который ушло письмо (reporterEmail задачи).
  fromEmail String?
  toEmail   String?
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

// Карта страниц проекта. Наполняется краулером (см. src/lib/crawler.ts): бот один раз
// обходит домен проекта по внутренним ссылкам и собирает URL'ы страниц (каталог и
// подкаталоги). На основе этих страниц и событий пользовательских сессий строится
// «карта загрузки»: среднее время до прогрузки конечного контента (события PAGE_LOAD)
// и критические/медленные запросы и статические файлы на каждой странице.
model ProjectPage {
  id        String  @id @default(cuid())
  projectId String
  // Путь страницы (pathname без схемы/хоста/query/hash). Нормализован: ведущий слэш,
  // без завершающего слэша (кроме корня "/"). Уникален в рамках проекта.
  path      String
  // <title> страницы, пойманный краулером (для читаемых подписей в дереве).
  title     String?
  // Глубина в дереве каталогов = число непустых сегментов пути (корень "/" — 0).
  depth     Int     @default(0)
  // Источник обнаружения: CRAWL (найдена краулером по ссылкам) | SESSION (замечена в
  // сессиях пользователей, но краулер до неё не дошёл).
  source    String  @default("CRAWL")
  // Когда страницу в последний раз видел краулер (для отсева исчезнувших страниц).
  lastCrawledAt DateTime?
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, path])
  @@index([projectId])
}

model Monitor {
  id             String        @id @default(cuid())
  projectId      String
  name           String
  url            String
  port           Int?          // порт для проверки; если не задан — 80 (http) или 443 (https)
  method         String        @default("GET") // GET | POST | PUT | DELETE
  interval       String        @default("1m")  // 1m | 1h | 1d
  expectedStatus Int           @default(200)
  timeoutMs      Int           @default(10000)
  headers        String?       // JSON-объект заголовков { "Name": "Value" }
  bodyType       String        @default("NONE") // NONE | JSON | XML | FORM
  body           String?       // тело запроса (для POST/PUT/DELETE)
  isActive       Boolean       @default(true)
  lastStatus     String        @default("PENDING") // UP | DOWN | PENDING
  lastCheckedAt  DateTime?
  createdAt      DateTime      @default(now())

  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  results        CheckResult[]
  alerts         Alert[]

  @@index([projectId])
  @@index([isActive])
}

model CheckResult {
  id             String   @id @default(cuid())
  monitorId      String
  ok             Boolean
  statusCode     Int?
  responseTimeMs Int?
  error          String?
  createdAt      DateTime @default(now())

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId, createdAt])
}

// ------------------------------- Сервис логирования -------------------------------
// Клиентский SDK на сайте проекта ловит фронт-ошибки и сетевые запросы, группирует их
// в пользовательские сессии и батчами шлёт на /api/logger/ingest. Проект определяется
// по Origin запроса (домен проекта). Данные хранятся ограниченный срок (ретеншн по тарифу).

model LogSession {
  id         String   @id @default(cuid())
  projectId  String
  // Идентификатор сессии, сгенерированный на клиенте (sessionStorage).
  sessionKey String
  userAgent  String?
  ip         String?
  // ISO-3166 alpha-2 код страны пользователя, определённый по IP при создании
  // сессии (см. resolveCountry в src/lib/geo.ts). null — не удалось определить.
  country    String?
  // Метки перехода, зафиксированные при старте сессии: UTM-параметры (utm_source,
  // utm_medium, utm_campaign, utm_term, utm_content) и рекламные идентификаторы клика
  // (yclid/ysclid — Яндекс, gclid — Google, fbclid — Facebook, etext — Яндекс.Директ).
  // JSON-объект { ключ: значение } из query-строки лендинга. null — прямой/органический
  // переход без меток. Фиксируется по first-touch: при старте новой сессии, а если её
  // ещё не было — при первом переходе, принёсшем метки; далее не перезаписывается.
  utm        String?
  startedAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  project    Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  events     LogEvent[]
  recChunks  RecordingChunk[]

  @@unique([projectId, sessionKey])
  @@index([projectId, startedAt])
}

// Запись экрана сессии (rrweb) хранится чанками: клиентский рекордер эмитит поток
// событий (полный DOM-снимок + инкрементальные мутации/движения мыши/скролл), SDK
// копит их и батчами шлёт на /api/logger/rec. Каждый батч — одна строка с JSON-массивом
// событий rrweb (поле data). Чтобы плеер собрал запись, чанки читаются по порядку seq.
// projectId денормализован — как и в LogEvent, для очистки по ретеншну и учёта одним
// запросом. Данные живут тот же срок, что и логи (см. purgeExpiredLogs).
model RecordingChunk {
  id        String   @id @default(cuid())
  projectId String
  sessionId String
  // Порядковый номер чанка внутри сессии (0,1,2…) — задаётся клиентом, монотонно растёт.
  seq       Int
  // JSON-массив событий rrweb в этом чанке (сериализованный на клиенте).
  data      String
  // Сколько событий rrweb в чанке — для статистики/диагностики без парсинга data.
  events    Int      @default(0)
  createdAt DateTime @default(now())

  session LogSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, seq])
  @@index([projectId, createdAt])
}

model LogEvent {
  id         String   @id @default(cuid())
  // projectId денормализован, чтобы очистка по ретеншну и учёт квоты шли одним deleteMany/count.
  projectId  String
  sessionId  String
  // ERROR | UNHANDLED_REJECTION | SLOW_REQUEST | HTTP_ERROR
  type       String
  message    String?
  stack      String?
  url        String?  // URL страницы, где произошло событие
  route      String?  // URL/маршрут сетевого запроса (с query-строкой)
  query      String?  // query-параметры запроса (усечено)
  method     String?
  statusCode Int?
  durationMs Int?
  reqBody    String?  // тело запроса / payload (усечено)
  resBody    String?  // тело ответа сервера (усечено; только для ошибок запросов)
  meta       String?  // произвольный JSON (расширяемость; hook под запись экрана)
  createdAt  DateTime @default(now())

  session LogSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([sessionId, createdAt])
}

// Исключения (игнор-лист) сервиса логирования. Каждое правило описывается двумя
// условиями, которые пользователь задаёт в модалке «В исключения»: категорией события
// (медленный запрос / ошибка) и условием по URL (содержит / равно). При приёме батча
// события, подходящие под правило, отбрасываются (см. matchesException в
// src/lib/exceptions.ts и фильтр в /api/logger/ingest).
model LogException {
  id        String   @id @default(cuid())
  projectId String
  // Категория события: SLOW_REQUEST (медленный запрос) | ERROR (ошибка — объединяет
  // ERROR, UNHANDLED_REJECTION и HTTP_ERROR).
  kind      String
  // Режим сопоставления URL: CONTAINS (содержит подстроку) | EQUALS (совпадает).
  urlMode   String
  // Строка URL для сопоставления. Для EQUALS сравнивается с endpoint события (путь без
  // query), для CONTAINS ищется как подстрока в URL запроса/страницы события.
  url       String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, kind, urlMode, url])
  @@index([projectId])
}

// Суточный счётчик числа новых пользовательских сессий на проект — для контроля квоты тарифа.
model LogUsage {
  id        String   @id @default(cuid())
  projectId String
  day       DateTime @db.Date
  sessions  Int      @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, day])
  @@index([projectId, day])
}

// Прогоны публичного инструмента проверки скорости сайта (см. /api/speed-test).
// Каждый запуск сохраняется для админ-статистики: какой домен проверяли, когда и
// с какой скоростью (готовность DOM). Личных данных не содержит.
model SpeedCheck {
  id                 String   @id @default(cuid())
  // Домен (hostname) проверенного сайта — для читаемого списка в админке.
  domain             String
  // Итоговый адрес, который проверяли (после переадресаций).
  url                String
  statusCode         Int
  ttfbMs             Int
  // Готовность DOM со скриптами — ключевая метрика скорости.
  domContentLoadedMs Int
  loadMs             Int
  requests           Int
  transferBytes      Int
  createdAt          DateTime @default(now())

  @@index([createdAt])
}

// Прогоны админ-инструмента «Обход» (см. /api/admin/scan и src/lib/siteScanner.ts).
// Бот обходит сайт по одному URL и формирует отчёт: ошибки бэкенда, медленные запросы,
// статика, найденные почты и телефоны. Каждый запуск сохраняется — админ видит историю,
// а полный отчёт лежит в JSON-поле report для повторного просмотра.
model SiteScan {
  id            String   @id @default(cuid())
  // Домен (hostname) обойдённого сайта — для читаемого списка.
  domain        String
  // Итоговый стартовый адрес (после переадресаций).
  url           String
  statusCode    Int      @default(0) // код ответа стартовой страницы
  pagesCrawled  Int      @default(0) // сколько HTML-страниц обошли
  requestsTotal Int      @default(0) // всего сетевых запросов (страницы + ресурсы)
  // Счётчики для списка без парсинга report.
  errorsCount   Int      @default(0)
  slowCount     Int      @default(0)
  assetsCount   Int      @default(0)
  emailsCount   Int      @default(0)
  phonesCount   Int      @default(0)
  durationMs    Int      @default(0)
  // Полный отчёт (ScanReport), сериализованный в JSON.
  report        String
  createdAt     DateTime @default(now())

  @@index([createdAt])
}

model Contact {
  id        String   @id @default(cuid())
  userId    String
  type      String   @default("EMAIL")
  value     String
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  alerts Alert[]

  @@index([userId])
}

model Alert {
  id        String   @id @default(cuid())
  monitorId String
  contactId String
  message   String
  kind      String   @default("DOWN") // DOWN | RECOVERY | SSL | DOMAIN | SUBSCRIPTION
  sentAt    DateTime @default(now())

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([monitorId])
}

model Subscription {
  id               String    @id @default(cuid())
  userId           String    @unique
  plan             String    @default("FREE") // FREE | PAID
  sitesLimit       Int       @default(1)
  priceRub         Int       @default(0)
  status           String    @default("inactive") // active | inactive
  // Для PAID — конец оплаченного периода.
  currentPeriodEnd DateTime?
  // Значение currentPeriodEnd, для которого уже отправлено предупреждение
  // «подписка истекает завтра». Нужно, чтобы оповещение ушло один раз за период:
  // при продлении currentPeriodEnd меняется — и напоминание срабатывает заново.
  expiryAlertSentFor DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Платежи через Т-Кассу (T-Bank эквайринг). Создаётся при инициации оплаты
// методом Init; статус обновляется по нотификации от Т-Кассы.
model Payment {
  id         String   @id @default(cuid())
  userId     String
  // Проект, тариф которого оплачивается (per-project биллинг).
  projectId  String?
  // Легаси-поле старой тарификации (T1000 | T3000). Больше не заполняется.
  tier       String?
  // Оплаченная кастомная конфигурация — применяется к проекту при подтверждении оплаты.
  sessionsPerDay Int?
  retentionHours Int?
  // OrderId, переданный в Т-Кассу (совпадает с id этой записи).
  orderId    String   @unique
  // PaymentId, присвоенный Т-Кассой.
  paymentId  String?
  // Кол-во сайтов (вырожденное поле, оставлено для совместимости со старыми оплатами).
  sites      Int      @default(1)
  // Длительность оплаченного периода в месяцах (1 | 3 | 12).
  months     Int      @default(1)
  // Сумма в рублях.
  amountRub  Int
  // NEW | AUTHORIZED | CONFIRMED | REJECTED | REFUNDED | CANCELED
  status     String   @default("NEW")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([projectId])
}
