# База данных — PostgreSQL
DATABASE_URL="postgresql://postgres:M0rfuREo4xh1hWtZuvIAuS85KQaa2LVNN7g@194.58.95.83:5432/logsy?schema=public"
# Для локальной разработки на SQLite: смените provider в prisma/schema.prisma
# на "sqlite" и укажите DATABASE_URL="file:./dev.db"

# NextAuth / Auth.js
# Сгенерируйте секрет: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-random-secret"
# Базовый URL приложения (для ссылок в письмах)
NEXTAUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# Yandex ID OAuth (необязательно). Без этих значений кнопка «Войти через Яндекс» скрыта.
# Создать приложение: https://oauth.yandex.ru/
# В настройках приложения Яндекса укажите Redirect URI (Callback URL):
#   ${NEXTAUTH_URL}/api/auth/callback/yandex
# Например, локально: http://localhost:3000/api/auth/callback/yandex
# Права доступа (scope, провайдер запрашивает по умолчанию login:info login:email login:avatar):
#   «Доступ к адресу электронной почты» (login:email) — обязательно, это ключ пользователя
#   «Доступ к логину, имени и фамилии» (login:info)
#   «Доступ к портрету пользователя» (login:avatar)
AUTH_YANDEX_ID=""
AUTH_YANDEX_SECRET=""

# SMTP для отправки писем (необязательно).
# Без этих значений письма выводятся в консоль сервера (dev-режим).
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Logsy <no-reply@logsy.ru>"

# Секретный токен для ручного запуска прогона проверок через POST /api/cron/run
CRON_SECRET="change-me-cron-secret"
